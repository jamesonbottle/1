<Page
    x:Class="ScreenTime.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenTime">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Used from code-behind when drawing the timeline lanes -->
        <SolidColorBrush x:Key="LaneBrush" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{ThemeResource TextFillColorSecondary}" Opacity="0.35" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,16" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Time Track" Style="{StaticResource TitleTextBlockStyle}" />

            <SelectorBar x:Name="Range" HorizontalAlignment="Left" SelectionChanged="OnRange">
                <SelectorBarItem x:Name="DayItem" Text="Day" IsSelected="True" />
                <SelectorBarItem x:Name="WeekItem" Text="Week" />
            </SelectorBar>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="Prev" Content="&#xE76B;" FontFamily="{StaticResource SymbolThemeFontFamily}" Click="OnPrev" />
                <TextBlock x:Name="DateText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button x:Name="Next" Grid.Column="2" Content="&#xE76C;" FontFamily="{StaticResource SymbolThemeFontFamily}" Click="OnNext" />
            </Grid>

            <!-- Total + bar chart -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TotalLabel" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock x:Name="TotalText" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <ItemsControl x:Name="Chart" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:Bar">
                                <StackPanel Width="{x:Bind Width}">
                                    <Grid Height="140">
                                        <Border Height="{x:Bind Height}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                                Margin="2,0" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind Label}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="PeakText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- Timeline: one horizontal lane per app (Day view only) -->
            <Border x:Name="TimelineCard" Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="TIMELINE" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <Grid x:Name="Axis" Margin="182,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="12a" FontSize="11" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="6a" FontSize="11" Opacity="0.7" />
                        <TextBlock Grid.Column="2" Text="12p" FontSize="11" Opacity="0.7" />
                        <TextBlock Grid.Column="3" Text="6p" FontSize="11" Opacity="0.7" />
                    </Grid>
                    <StackPanel x:Name="Lanes" Spacing="4" />
                    <TextBlock x:Name="LaneHint" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- Pickups -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PickupsLabel" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBlock x:Name="PickupsText" Style="{StaticResource TitleLargeTextBlockStyle}" />
                </StackPanel>
            </Border>

            <!-- Most used -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="MOST USED" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ItemsControl x:Name="AppsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:AppUsage">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{x:Bind Icon}" Width="32" Height="32" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{x:Bind Percent}" Maximum="100" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Time}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
