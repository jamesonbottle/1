<Window
    x:Class="ScreenTime.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Screen Time">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Same structure as the Windows 11 Settings and Store apps: the title bar is merged into the window over
         Mica, with a left navigation pane. NavigationView draws the lighter, rounded content surface itself. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Screen Time"
                  IsBackButtonVisible="False" IsPaneToggleButtonVisible="False" />

        <!-- The three-line (hamburger) button lives at the top of the left pane itself, not in the title bar.
             It collapses the pane to icons and expands it again. -->
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="True" IsSettingsVisible="True"
                        SelectionChanged="OnNav">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Time Track">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="Host" />
        </NavigationView>
    </Grid>
</Window>
